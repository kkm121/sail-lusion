{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/", "destination": "/v2", "permanent": false },
    { "source": "/about", "destination": "/v2/about", "permanent": false },
    { "source": "/domains/:path*", "destination": "/v2/domains/:path*", "permanent": false },
    { "source": "/projects/:path*", "destination": "/v2/projects/:path*", "permanent": false }
  ],
  "rewrites": [
    {
      "source": "/v1/((?!assets/|brand/|.*\\.[\\w]+$).*)",
      "destination": "/v1/index.html"
    },
    {
      "source": "/v1",
      "destination": "/v1/index.html"
    },
    {
      "source": "/v2/((?!assets/|media/|models/|video/|brand/|.*\\.[\\w]+$).*)",
      "destination": "/v2/index.html"
    },
    {
      "source": "/v2",
      "destination": "/v2/index.html"
    },
    {
      "source": "/v3/((?!assets/|media/|brand/|.*\\.[\\w]+$).*)",
      "destination": "/v3/index.html"
    },
    {
      "source": "/v3",
      "destination": "/v3/index.html"
    }
  ],
  "headers": [
    {
      "source": "/:ver(v1|v2|v3)/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/:ver(v1|v2|v3)/(models|media|video)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
