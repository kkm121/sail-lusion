{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/v1/((?!assets/|brand/|.*\\.[\\w]+$).*)",
      "destination": "/v1/index.html"
    },
    {
      "source": "/v1",
      "destination": "/v1/index.html"
    },
    {
      "source": "/v2/((?!assets/|media/|models/|video/|brand/|.*\\.[\\w]+$).*)",
      "destination": "/v2/index.html"
    },
    {
      "source": "/v2",
      "destination": "/v2/index.html"
    },
    {
      "source": "/v3/((?!assets/|media/|brand/|.*\\.[\\w]+$).*)",
      "destination": "/v3/index.html"
    },
    {
      "source": "/v3",
      "destination": "/v3/index.html"
    },
    {
      "source": "/v3p2/((?!assets/|brand/|.*\\.[\\w]+$).*)",
      "destination": "/v3p2/index.html"
    },
    {
      "source": "/v3p2",
      "destination": "/v3p2/index.html"
    },
    {
      "source": "/v4/((?!assets/|brand/|.*\\.[\\w]+$).*)",
      "destination": "/v4/index.html"
    },
    {
      "source": "/v4",
      "destination": "/v4/index.html"
    },
    {
      "source": "/((?!v1(?:/|$)|v2(?:/|$)|v3(?:/|$)|v3p2(?:/|$)|v4(?:/|$)|assets/|brand/|media/|env/|models/|team/|.*\\.[\\w]+$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/:ver(v1|v2|v3|v3p2|v4)/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/:ver(v1|v2|v3|v3p2|v4)/(models|media|video)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(models|env)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/v4",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/v4/:path*",
      "destination": "/:path*",
      "permanent": false
    }
  ]
}