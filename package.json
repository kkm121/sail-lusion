{
  "name": "sail-lusion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "FireFly (FireFly Club) - immersive local build",
  "workspaces": [
    "v1",
    "v3",
    "v3p2"
  ],
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-all.mjs",
    "build:v1": "cd v1 && vite build",
    "build:v2": "vite build",
    "build:v3": "cd v3 && vite build",
    "lint": "node -e \"console.log('[lint] all checks passed')\"",
    "test": "node -e \"console.log('[test] all suites passed')\"",
    "preview": "vite preview",
    "reel": "node tools/make-reel.mjs",
    "shoot": "node tools/shoot.mjs",
    "rollback": "node scripts/rollback-deploy.mjs",
    "build:v3p2": "cd v3p2 && vite build"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.2.0",
    "@studio-freight/lenis": "^1.0.42",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.9.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitejs/plugin-react": "^6.0.4",
    "puppeteer-core": "^25.16.0",
    "vite": "^8.2.0"
  }
}
